# ─────────────────────────────────────────────────────────────────────────────
#  Environment variables for the Retinal Disease Classifier stack.
#
#  1. Copy this file:   cp .env.example .env
#  2. Fill in values
#  3. Keep .env out of version control (it's in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── HuggingFace model ─────────────────────────────────────────────────────────
HF_MODEL_REPO=lebiraja/retinal-disease-classifier
HF_MODEL_FILE=pytorch_model.bin

# ── (Optional) Skip HuggingFace download by pointing to a local checkpoint.
# Mount the host directory in docker-compose.yml and set this path.
# MODEL_CHECKPOINT_PATH=/checkpoints/best_model.pt

# ── API settings ──────────────────────────────────────────────────────────────
DEFAULT_THRESHOLD=0.5
MAX_FILE_SIZE_MB=20

# ── VLM — Featherless AI (Kimi-K2.5) ────────────────────────────────────────────
FEATHERLESS_API_KEY=your_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=moonshotai/Kimi-K2.5
FEATHERLESS_TEMPERATURE=0.2

# ── CORS — restrict in production to your frontend domain ────────────────────
# Example: CORS_ORIGINS=https://retinal.yourdomain.com
CORS_ORIGINS=*

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: debug | info | warning | error | critical
LOG_LEVEL=info

# ── Public port (host port that Nginx listens on) ─────────────────────────────
HTTP_PORT=7000
