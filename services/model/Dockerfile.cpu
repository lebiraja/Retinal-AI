# ─────────────────────────────────────────────────────────────────────────────
#  Model Service — CPU-only inference container (for testing / no GPU host)
#
#  Uses standard PyTorch CPU wheel from PyPI (~300MB vs ~2GB GPU wheel).
#  Inference will be slower but functionally identical.
#
#  Build (via docker-compose.cpu.yml):
#    docker compose -f docker-compose.cpu.yml up --build
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: dependency builder ────────────────────────────────────────────────
FROM python:3.11-slim AS deps

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        libgomp1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# CPU-only torch — pytorch.org/whl/cpu strips all CUDA libs (~200MB vs ~2GB)
RUN pip install --no-cache-dir \
    torch==2.3.1+cpu \
    torchvision==0.18.1+cpu \
    --index-url https://download.pytorch.org/whl/cpu

# Remaining app dependencies
COPY services/model/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# ── Stage 2: production image ──────────────────────────────────────────────────
FROM python:3.11-slim AS production

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        libgomp1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1001 appgroup \
    && useradd --uid 1001 --gid 1001 --no-create-home --shell /bin/false appuser

WORKDIR /app

COPY --from=deps /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin

# Application source
COPY services/model/src ./services/model/src
RUN touch ./services/__init__.py ./services/model/__init__.py

RUN mkdir -p /app/.cache/huggingface /app/.cache/torch \
    && chown -R appuser:appgroup /app

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV HF_HOME=/app/.cache/huggingface
ENV TORCH_HOME=/app/.cache/torch
ENV MODEL_SERVICE_HOST=0.0.0.0
ENV MODEL_SERVICE_PORT=8001
ENV LOG_LEVEL=info

EXPOSE 8001

USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

CMD ["python", "-m", "uvicorn", \
     "services.model.src.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8001", \
     "--log-level", "info", \
     "--workers", "1"]
